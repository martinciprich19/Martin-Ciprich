<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="riva_background">#061016</color>
    <style name="RivaTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/riva_background</item>
        <item name="android:colorBackground">@color/riva_background</item>
        <item name="android:statusBarColor">@color/riva_background</item>
